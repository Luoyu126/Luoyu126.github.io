---
layout: default
---
{% assign year = page.date | date: '%Y' %}
{% assign tags = page.tags | join: '' %}
{% assign categories = page.categories | join: '' %}
{% assign url_beginning = page.url | slice: 0, 6 %}

{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<div class="post">
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>
    <p class="post-meta">
      Created on {{ page.date | date: '%B %d, %Y' }}
      {% if page.author %}by {{ page.author }}{% endif %}
      {% if page.last_updated %}, last updated on {{ page.last_updated | date: '%B %d, %Y' }}{% endif %}
      {% if page.meta %}• {{ page.meta }}{% endif %}
    </p>
    <p class="post-tags">
      {% if url_beginning == '/blog/' %}
        <a href="{{ year | prepend: '/blog/' | relative_url }}"> <i class="fa-solid fa-calendar fa-sm"></i> {{ year }} </a>
      {% else %}
        <i class="fa-solid fa-calendar fa-sm"></i> {{ year }}
      {% endif %}
      {% if tags != '' %}
        &nbsp; &middot; &nbsp;
        {% for tag in page.tags %}
          {% if url_beginning == '/blog/' %}
            <a href="{{ tag | slugify | prepend: '/blog/tag/' | relative_url }}"> <i class="fa-solid fa-hashtag fa-sm"></i> {{ tag }}</a>
          {% else %}
            <i class="fa-solid fa-hashtag fa-sm"></i> {{ tag }}
          {% endif %}
          {% unless forloop.last %}
            &nbsp;
          {% endunless %}
        {% endfor %}
      {% endif %}

      {% if categories != '' %}
        &nbsp; &middot; &nbsp;
        {% for category in page.categories %}
          {% if url_beginning == '/blog/' %}
            <a href="{{ category | slugify | prepend: '/blog/category/' | relative_url }}"> <i class="fa-solid fa-tag fa-sm"></i> {{ category -}}</a>
          {% else %}
            <i class="fa-solid fa-tag fa-sm"></i> {{ category }}
          {% endif %}
          {% unless forloop.last %}
            &nbsp;
          {% endunless %}
        {% endfor %}
      {% endif %}
    </p>
  </header>

  <article class="post-content">
    {% if page.toc and page.toc.beginning %}
      <div id="table-of-contents">
        {% toc %}
      </div>
      <hr>
    {% endif %}
    <div id="markdown-content">
      {{ content }}
    </div>
  </article>

  {% if page.citation %}
    {% include citation.liquid %}
  {% endif %}

  {% if page.related_publications %}
    <h2>References</h2>
    <div class="publications">
      {% bibliography --group_by none --cited_in_order %}
    </div>
  {% endif %}

  {% if site.related_blog_posts and site.related_blog_posts.enabled %}
    {% if page.related_posts == null or page.related_posts %}
      {% include related_posts.liquid %}
    {% endif %}
  {% endif %}

  {% assign github_repo = site.giscus.repo %}
  {% assign like_key_source = page.id | default: page.url %}
  {% assign like_key = like_key_source | replace: '/', '--' | replace: '.', '-' | replace: ':', '-' %}
  {% assign repo_star_key = github_repo | replace: '/', '--' | replace: '.', '-' | replace: ':', '-' %}
  <div class="post-social-actions">
    <button class="post-social-link post-like-button" data-like-key="{{ like_key }}" type="button" aria-label="Like this post">
      <i class="fa-regular fa-heart fa-sm"></i>
      <span class="post-action-label">Like</span>
      <span class="post-like-count">0</span>
    </button>
    <button class="post-social-link post-comment-focus" type="button" aria-label="Write a comment">
      <i class="fa-regular fa-comment fa-sm"></i>
      Comment
    </button>
    <button class="post-social-link post-repo-star-button" data-star-key="{{ repo_star_key }}" type="button" aria-label="Star repository">
      <i class="fa-regular fa-star fa-sm"></i>
      <span class="post-action-label">Star Repo</span>
      <span class="post-repo-star-count">0</span>
    </button>
  </div>

  <section id="post-comments" class="post-comment-section">
    <h3>Comments</h3>
    <form id="post-comment-form" class="post-comment-form">
      <input id="post-comment-name" type="text" maxlength="40" placeholder="Your name (optional)">
      <textarea id="post-comment-text" rows="4" maxlength="1000" placeholder="Write your comment..."></textarea>
      <button type="submit" class="post-comment-submit">Post Comment</button>
    </form>
    <p class="post-comment-note">Comments are shown instantly below this post.</p>
    <div id="post-comment-empty" class="post-comment-empty">No comments yet.</div>
    <ul id="post-comment-list" class="post-comment-list"></ul>
  </section>

  <script>
    (() => {
      const SUPABASE_URL = "{{ site.supabase.url | default: '' }}";
      const SUPABASE_ANON_KEY = "{{ site.supabase.anon_key | default: '' }}";
      const NORMALIZED_SUPABASE_URL = SUPABASE_URL.replace(/\/rest\/v1\/?$/, "").replace(/\/$/, "");
      const LIKE_CACHE_KEY = "blog-like-cache-v1";
      const FETCH_TIMEOUT_MS = 2000;
      const REPO_STAR_URL = "https://github.com/Luoyu126/Luoyu126.github.io/stargazers";
      const hasSupabaseConfig = Boolean(NORMALIZED_SUPABASE_URL && SUPABASE_ANON_KEY);

      const likeButton = document.querySelector(".post-like-button");
      const repoStarButton = document.querySelector(".post-repo-star-button");
      const commentFocusButton = document.querySelector(".post-comment-focus");
      const commentForm = document.getElementById("post-comment-form");
      const commentNameInput = document.getElementById("post-comment-name");
      const commentTextInput = document.getElementById("post-comment-text");
      const commentList = document.getElementById("post-comment-list");
      const commentEmpty = document.getElementById("post-comment-empty");

      let supabaseClientPromise = null;

      const readLikeCache = () => {
        try {
          const parsed = JSON.parse(localStorage.getItem(LIKE_CACHE_KEY) || "{}");
          return parsed && typeof parsed.counts === "object" ? parsed.counts : {};
        } catch (error) {
          return {};
        }
      };

      const writeLikeCache = (counts) => {
        localStorage.setItem(LIKE_CACHE_KEY, JSON.stringify({ updatedAt: Date.now(), counts }));
      };

      const getCachedLikeCount = (slug, fallbackValue) => {
        const counts = readLikeCache();
        const value = Number(counts[slug]);
        return Number.isFinite(value) ? value : fallbackValue;
      };

      const setCachedLikeCount = (slug, value) => {
        const counts = readLikeCache();
        counts[slug] = Math.max(0, Number(value) || 0);
        writeLikeCache(counts);
      };

      const withTimeout = (promise, timeoutMs) =>
        Promise.race([
          promise,
          new Promise((_, reject) => {
            setTimeout(() => reject(new Error("timeout")), timeoutMs);
          }),
        ]);

      const getSupabaseClient = async () => {
        if (!hasSupabaseConfig) return null;
        if (!supabaseClientPromise) {
          supabaseClientPromise = import("https://cdn.jsdelivr.net/npm/@supabase/supabase-js/+esm").then((mod) =>
            mod.createClient(NORMALIZED_SUPABASE_URL, SUPABASE_ANON_KEY, {
              auth: { persistSession: false },
            })
          );
        }
        return supabaseClientPromise;
      };

      const getRemoteLikeCount = async (slug, fallbackValue) => {
        if (!hasSupabaseConfig || !slug) return fallbackValue;
        try {
          const supabase = await getSupabaseClient();
          const query = supabase.from("post_stats").select("likes").eq("slug", slug).maybeSingle();
          const { data, error } = await withTimeout(query, FETCH_TIMEOUT_MS);
          if (error) throw error;
          const value = Number(data?.likes) || 0;
          setCachedLikeCount(slug, value);
          return value;
        } catch (error) {
          return fallbackValue;
        }
      };

      const updateRemoteLikeCount = async (slug, delta, optimisticValue) => {
        if (!hasSupabaseConfig || !slug) return optimisticValue;
        const safeValue = Math.max(0, Number(optimisticValue) || 0);
        try {
          const supabase = await getSupabaseClient();
          const rpcQuery = supabase.rpc("increment_post_likes", {
            p_slug: slug,
            p_delta: delta,
          });
          const { data, error } = await withTimeout(rpcQuery, FETCH_TIMEOUT_MS);
          if (error) throw error;
          const value = Number(data);
          if (Number.isFinite(value)) return Math.max(0, value);
          return safeValue;
        } catch (error) {
          try {
            const supabase = await getSupabaseClient();
            const upsertQuery = supabase
              .from("post_stats")
              .upsert({ slug, likes: safeValue }, { onConflict: "slug" });
            const { error: upsertError } = await withTimeout(upsertQuery, FETCH_TIMEOUT_MS);
            if (upsertError) throw upsertError;
          } catch (upsertFallbackError) {
            // Keep optimistic value if backend is unavailable.
          }
          return safeValue;
        }
      };

      const showSupportToast = () => {
        let toast = document.getElementById("like-support-toast");
        if (!toast) {
          toast = document.createElement("div");
          toast.id = "like-support-toast";
          toast.style.cssText = [
            "position: fixed",
            "right: 16px",
            "bottom: 16px",
            "z-index: 2000",
            "padding: 10px 14px",
            "border-radius: 10px",
            "border: 1px solid rgba(128,128,128,0.3)",
            "background: rgba(35,35,35,0.92)",
            "color: #fff",
            "font-size: 14px",
            "box-shadow: 0 8px 24px rgba(0,0,0,0.25)",
            "opacity: 0",
            "transform: translateY(8px)",
            "transition: opacity 160ms ease, transform 160ms ease",
            "pointer-events: none",
          ].join("; ");
          document.body.appendChild(toast);
        }
        toast.textContent = "感谢支持！欢迎去 GitHub 给主页点个星 ✨";
        toast.style.opacity = "1";
        toast.style.transform = "translateY(0)";

        window.clearTimeout(showSupportToast._timer);
        showSupportToast._timer = window.setTimeout(() => {
          toast.style.opacity = "0";
          toast.style.transform = "translateY(8px)";
        }, 2200);
      };

      const bindLikeButton = () => {
        if (!likeButton) return;
        const slug = likeButton.dataset.likeKey || "";
        if (!slug) return;

        const countEl = likeButton.querySelector(".post-like-count");
        const labelEl = likeButton.querySelector(".post-action-label");
        if (!countEl) return;

        const flagKey = `liked:${slug}`;

        const setCount = (value) => {
          countEl.textContent = String(Math.max(0, Number(value) || 0));
        };

        const setActiveState = (active) => {
          likeButton.classList.toggle("is-liked", active);
          likeButton.setAttribute("aria-pressed", active ? "true" : "false");
          if (labelEl) labelEl.textContent = active ? "Unlike" : "Like";
        };

        const readLiked = () => localStorage.getItem(flagKey) === "true";
        const writeLiked = (active) => localStorage.setItem(flagKey, active ? "true" : "false");

        const fallbackCount = Number(countEl.textContent) || 0;
        const cachedCount = getCachedLikeCount(slug, fallbackCount);
        setCount(cachedCount);
        setActiveState(readLiked());

        getRemoteLikeCount(slug, cachedCount).then(setCount);

        likeButton.addEventListener("click", async () => {
          const nextActive = !readLiked();
          const delta = nextActive ? 1 : -1;
          writeLiked(nextActive);
          setActiveState(nextActive);

          const optimisticValue = Math.max(0, getCachedLikeCount(slug, 0) + delta);
          setCachedLikeCount(slug, optimisticValue);
          setCount(optimisticValue);

          const value = await updateRemoteLikeCount(slug, delta, optimisticValue);
          setCachedLikeCount(slug, value);
          setCount(value);

          if (nextActive) showSupportToast();
        });
      };

      bindLikeButton();

      if (repoStarButton) {
        const countEl = repoStarButton.querySelector(".post-repo-star-count");
        if (countEl) countEl.remove();
        repoStarButton.addEventListener("click", () => {
          window.open(REPO_STAR_URL, "_blank", "noopener,noreferrer");
        });
      }

      if (commentFocusButton && commentTextInput) {
        commentFocusButton.addEventListener("click", () => {
          const commentSection = document.getElementById("post-comments");
          if (commentSection) {
            commentSection.scrollIntoView({ behavior: "smooth", block: "start" });
          }
          commentTextInput.focus();
        });
      }

      const commentStorageKey = `comments:{{ like_key }}`;

      const loadComments = () => {
        try {
          const parsed = JSON.parse(localStorage.getItem(commentStorageKey) || "[]");
          return Array.isArray(parsed) ? parsed : [];
        } catch (error) {
          return [];
        }
      };

      const saveComments = (comments) => {
        localStorage.setItem(commentStorageKey, JSON.stringify(comments));
      };

      const renderComments = () => {
        if (!commentList || !commentEmpty) return;

        const comments = loadComments().sort((a, b) => (b.createdAt || 0) - (a.createdAt || 0));
        commentList.innerHTML = "";
        commentEmpty.style.display = comments.length > 0 ? "none" : "block";

        comments.forEach((comment) => {
          const item = document.createElement("li");
          item.className = "post-comment-item";

          const meta = document.createElement("div");
          meta.className = "post-comment-meta";
          const date = new Date(comment.createdAt || Date.now());
          meta.textContent = `${comment.name || "Anonymous"} · ${date.toLocaleString()}`;

          const content = document.createElement("p");
          content.className = "post-comment-content";
          content.textContent = comment.text || "";

          item.appendChild(meta);
          item.appendChild(content);
          commentList.appendChild(item);
        });
      };

      renderComments();

      if (commentForm && commentTextInput) {
        commentForm.addEventListener("submit", (event) => {
          event.preventDefault();
          const text = commentTextInput.value.trim();
          if (!text) return;

          const name = commentNameInput?.value.trim() || "Anonymous";
          const comments = loadComments();
          comments.push({
            id: Date.now(),
            name,
            text,
            createdAt: Date.now(),
          });
          saveComments(comments);
          commentTextInput.value = "";
          if (commentNameInput) commentNameInput.value = "";
          renderComments();
        });
      }
    })();
  </script>
</div>
