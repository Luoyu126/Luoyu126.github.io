---
layout: default
---
{% assign year = page.date | date: '%Y' %}
{% assign tags = page.tags | join: '' %}
{% assign categories = page.categories | join: '' %}
{% assign url_beginning = page.url | slice: 0, 6 %}

{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<div class="post">
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>
    <p class="post-meta">
      Created on {{ page.date | date: '%B %d, %Y' }}
      {% if page.author %}by {{ page.author }}{% endif %}
      {% if page.last_updated %}, last updated on {{ page.last_updated | date: '%B %d, %Y' }}{% endif %}
      {% if page.meta %}• {{ page.meta }}{% endif %}
    </p>
    <p class="post-tags">
      {% if url_beginning == '/blog/' %}
        <a href="{{ year | prepend: '/blog/' | relative_url }}"> <i class="fa-solid fa-calendar fa-sm"></i> {{ year }} </a>
      {% else %}
        <i class="fa-solid fa-calendar fa-sm"></i> {{ year }}
      {% endif %}
      {% if tags != '' %}
        &nbsp; &middot; &nbsp;
        {% for tag in page.tags %}
          {% if url_beginning == '/blog/' %}
            <a href="{{ tag | slugify | prepend: '/blog/tag/' | relative_url }}"> <i class="fa-solid fa-hashtag fa-sm"></i> {{ tag }}</a>
          {% else %}
            <i class="fa-solid fa-hashtag fa-sm"></i> {{ tag }}
          {% endif %}
          {% unless forloop.last %}
            &nbsp;
          {% endunless %}
        {% endfor %}
      {% endif %}

      {% if categories != '' %}
        &nbsp; &middot; &nbsp;
        {% for category in page.categories %}
          {% if url_beginning == '/blog/' %}
            <a href="{{ category | slugify | prepend: '/blog/category/' | relative_url }}"> <i class="fa-solid fa-tag fa-sm"></i> {{ category -}}</a>
          {% else %}
            <i class="fa-solid fa-tag fa-sm"></i> {{ category }}
          {% endif %}
          {% unless forloop.last %}
            &nbsp;
          {% endunless %}
        {% endfor %}
      {% endif %}
    </p>
  </header>

  <article class="post-content">
    {% if page.toc and page.toc.beginning %}
      <div id="table-of-contents">
        {% toc %}
      </div>
      <hr>
    {% endif %}
    <div id="markdown-content">
      {{ content }}
    </div>
  </article>

  {% if page.citation %}
    {% include citation.liquid %}
  {% endif %}

  {% if page.related_publications %}
    <h2>References</h2>
    <div class="publications">
      {% bibliography --group_by none --cited_in_order %}
    </div>
  {% endif %}

  {% if site.related_blog_posts and site.related_blog_posts.enabled %}
    {% if page.related_posts == null or page.related_posts %}
      {% include related_posts.liquid %}
    {% endif %}
  {% endif %}

  {% assign github_repo = site.giscus.repo %}
  {% assign repo_owner = github_repo | split: '/' | first %}
  {% assign repo_name = github_repo | split: '/' | last %}
  {% assign like_key = page.url | replace: '/', '--' | replace: '.', '-' | replace: ':', '-' %}
  {% assign discussion_title = 'Comment on: ' | append: page.title %}
  {% assign discussion_title_escaped = discussion_title | uri_escape %}
  {% assign discussion_url = 'https://github.com/' | append: github_repo | append: '/discussions/new?category=general&title=' | append: discussion_title_escaped %}
  {% if github_repo != blank %}
    <div class="post-social-actions">
      <button class="post-social-link post-like-button" data-like-key="{{ like_key }}" type="button" aria-label="Like this post">
        <i class="fa-regular fa-heart fa-sm"></i>
        Like
        <span class="post-like-count">0</span>
      </button>
      <a class="post-social-link" href="{{ discussion_url }}" target="_blank" rel="noopener noreferrer">
        <i class="fa-regular fa-comment fa-sm"></i>
        Comment
      </a>
      {% if github_repo != blank %}
        <iframe
          src="https://ghbtns.com/github-btn.html?user={{ repo_owner }}&repo={{ repo_name }}&type=star&count=true"
          width="170"
          height="20"
          title="Star {{ github_repo }} on GitHub"
        ></iframe>
      {% endif %}
    </div>
  {% endif %}

  <script>
    (() => {
      const button = document.querySelector(".post-like-button");
      if (!button) return;

      const namespace = "chenyy-homepage-post-likes";
      const rawKey = button.dataset.likeKey;
      const key = encodeURIComponent(rawKey || "");
      const countEl = button.querySelector(".post-like-count");
      const storageKey = `liked:${namespace}:${rawKey}`;

      if (!rawKey || !countEl) return;

      const setLikedState = (isLiked) => {
        button.classList.toggle("is-liked", isLiked);
        button.disabled = isLiked;
      };

      const setCount = (value) => {
        countEl.textContent = Number.isFinite(value) ? String(value) : "0";
      };

      const getCount = async () => {
        try {
          const response = await fetch(`https://api.countapi.xyz/get/${namespace}/${key}`);
          const data = await response.json();
          return Number(data.value) || 0;
        } catch (error) {
          return 0;
        }
      };

      const hitCount = async () => {
        try {
          const response = await fetch(`https://api.countapi.xyz/hit/${namespace}/${key}`);
          const data = await response.json();
          return Number(data.value) || 0;
        } catch (error) {
          return null;
        }
      };

      const alreadyLiked = localStorage.getItem(storageKey) === "true";
      setLikedState(alreadyLiked);

      getCount().then(setCount);

      button.addEventListener("click", async () => {
        if (localStorage.getItem(storageKey) === "true") return;
        const newValue = await hitCount();
        if (newValue === null) return;
        setCount(newValue);
        localStorage.setItem(storageKey, "true");
        setLikedState(true);
      });
    })();
  </script>

  {% if site.disqus_shortname and page.disqus_comments %}
    {% include disqus.liquid %}
  {% endif %}
  {% if site.giscus.enabled and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}
</div>
